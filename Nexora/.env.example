# .env.example — environment secrets template (DO NOT commit real values)
FIREBASE_WEB_API_KEY=your_firebase_web_key_here
FIREBASE_ANDROID_API_KEY=your_firebase_android_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=1:your_project:web:your_app_id
IMGBB_API_KEY=your_imgbb_api_key_here
NEXUS_PROJECT_FIREBASE_KEY=your_nexus_project_key_here
NEXUS_FIREBASE_APP_ID=1:your_nexus_project:web:your_app_id
NEXUS_FIREBASE_AUTH_DOMAIN=your_nexus_project.firebaseapp.com
NEXUS_FIREBASE_PROJECT_ID=your_nexus_project_id
NEXUS_FIREBASE_STORAGE_BUCKET=your_nexus_project.firebasestorage.app
NEXUS_FIREBASE_DATABASE_URL=https://your_nexus_project-default-rtdb.asia-southeast1.firebasedatabase.app
NEXUS_FIREBASE_MESSAGING_SENDER_ID=your_nexus_messaging_sender_id
